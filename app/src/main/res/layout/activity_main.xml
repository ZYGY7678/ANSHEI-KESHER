<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#0B0C10">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="עסקים וטלפונים בישראל" android:textColor="#FFFFFF" android:textSize="25sp"
        android:textStyle="bold" android:gravity="right" android:padding="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="בחר עיר כדי לעיין ברשימת העסקים, או חפש בכל הארץ"
        android:textColor="#9AA0A6" android:textSize="14sp" android:gravity="right" android:padding="0dp"/>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="10dp" android:hint="🔎  חיפוש בכל המאגר או בעיר הנבחרת"
        android:textColor="#FFFFFF" android:textColorHint="#8C949E"
        android:singleLine="true" android:inputType="text" android:background="#1F2833" android:padding="13dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/allButton" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="כל הארץ" android:textColor="#66FCF1" android:textSize="15sp"
            android:background="#1F2833" android:textAllCaps="false"/>
        <HorizontalScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/cityBar" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="טוען מאגר..." android:textColor="#66FCF1" android:textSize="14sp"
        android:gravity="right" android:padding="8dp"/>
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="#252A31" android:dividerHeight="1dp"/>
</LinearLayout>