<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#305A59"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#264744"/><stroke android:width="2dp" android:color="#66FCF1"/><corners android:radius="10dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#1B222A"/><corners android:radius="10dp"/></shape>
    </item>
</selector>